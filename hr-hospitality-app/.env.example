# HR-HOSPITALITY — configuração pública do frontend
# Copie apenas para .env.local. Nunca introduza SUPABASE_SERVICE_ROLE_KEY,
# PGPASSWORD, tokens Vercel ou credenciais de QA neste ficheiro.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_AQUI

# URL HTTPS usada nos convites/recuperação do Supabase Auth.
# A configuração é feita no painel do Supabase; não é usada pelo browser.
# SUPABASE_AUTH_REDIRECT_URL=https://app.exemplo.ao/alterar-palavra-passe

# Variáveis exclusive do runner de migrações (secret manager, nunca neste ficheiro):
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=
# PGPASSWORD=
