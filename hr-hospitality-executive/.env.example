# Configuração do Supabase para a app de gestão do Hotel Lukweku.
#
# A app é exclusiva de proprietários e gerentes: autentica-se com contas de
# STAFF de perfil `EXECUTIVO` (ou `ADMINISTRATOR`). A RLS da migração 007 dá
# leitura integral do tenant e NÃO cria nenhuma policy de escrita para
# `EXECUTIVO` — a app é de leitura por construção.
#
# NUNCA adicionar SUPABASE_SERVICE_ROLE_KEY.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA
