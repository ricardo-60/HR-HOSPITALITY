# Configuração pública do Supabase (Hotel Lukweku Mobile)
#
# Copie para `.env` e preencha com os valores do painel do Supabase.
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele o Expo não expõe a variável
# ao código do cliente.
#
# NUNCA adicionar aqui a SUPABASE_SERVICE_ROLE_KEY: esta variável é embutida no
# pacote da aplicação e ficaria publicamente visível para qualquer utilizador.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Sem estas duas variáveis a app arranca em "modo demonstração": mostra o aviso
# de configuração e funciona apenas com o cache local.
