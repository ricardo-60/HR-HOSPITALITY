# Valores Secretos do Edge Function (configurar como secrets no Supabase).
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são fornecidos
# automaticamente pelo ambiente da Edge Function.

APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SUPABASE_AUTH_REDIRECT_URL=https://app.exemplo.ao/alterar-palavra-passe

# Token forte, aleatório e de uso único para criar o primeiro administrador.
# Remover depois do bootstrap.
BOOTSTRAP_TOKEN=GERE_UM_TOKEN_ALEATORIO_DE_USO_UNICO
