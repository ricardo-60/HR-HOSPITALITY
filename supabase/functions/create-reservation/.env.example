# Secrets da Edge Function `create-reservation`.
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são fornecidos
# automaticamente pelo ambiente da Edge Function — não os defina aqui.

# Origens HTTP autorizadas (separadas por vírgula). Devem ser as origens exatas
# do site/app web. Para a aplicação móvil, defina APP_ALLOW_NULL_ORIGIN=true
# porque as apps nativas enviam `Origin: null`.
APP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_ALLOW_NULL_ORIGIN=true
